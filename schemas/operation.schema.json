{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://omniform.dev/schemas/operation.schema.json",
  "title":"Omniform Operation Definition",
  "type":"object",
  "additionalProperties":false,
  "required":["id","version","name","description","capability","input","output","mutation","permissions","approval","interfaces"],
  "properties":{
    "id":{"type":"string","pattern":"^[a-z][a-z0-9_]*$"},
    "version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "name":{"type":"string","minLength":1},
    "description":{"type":"string","minLength":1},
    "capability":{"type":"string","pattern":"^[a-z][a-z0-9_-]*$"},
    "input":{"type":"object"},
    "output":{"type":"object"},
    "mutation":{"type":"boolean"},
    "permissions":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "approval":{"type":"object","required":["mode"],"additionalProperties":false,"properties":{"mode":{"enum":["none","policy","required"]}}},
    "risk":{"enum":["none","low","medium","high","critical"]},
    "reversible":{"type":"boolean"},
    "interfaces":{"type":"array","items":{"enum":["human","agent","cli","api","machine"]},"uniqueItems":true,"minItems":1},
    "evidenceProduced":{"type":"array","items":{"type":"string"}},
    "eventsEmitted":{"type":"array","items":{"type":"string"}},
    "applicableResourceTypes":{"type":"array","items":{"type":"string"}},
    "presentation":{"type":"object","additionalProperties":false,"properties":{"label":{"type":"string"},"category":{"type":"string"},"importance":{"enum":["primary","secondary","advanced"]}}},
    "deprecated":{"type":"boolean"},
    "replacedBy":{"type":"string"}
  }
}
