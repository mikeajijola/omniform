{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://omniform.dev/schemas/company.schema.json","type":"object","additionalProperties":false,
  "required":["id","name","purpose","capabilities"],
  "properties":{"id":{"$ref":"#/$defs/id"},"name":{"type":"string","minLength":1},"purpose":{"type":"string","minLength":1},"outcomes":{"type":"array","items":{"type":"object","required":["id","description"],"additionalProperties":false,"properties":{"id":{"$ref":"#/$defs/id"},"description":{"type":"string","minLength":1}}}},"capabilities":{"type":"array","items":{"$ref":"capability.schema.json"}},"resources":{"type":"array","items":{"$ref":"resource.schema.json"}},"skills":{"type":"array","items":{"$ref":"skill.schema.json"}},"connectors":{"type":"array","items":{"$ref":"connector.schema.json"}},"workflows":{"type":"array","items":{"$ref":"workflow.schema.json"}},"schedules":{"type":"array","items":{"$ref":"schedule.schema.json"}},"realisations":{"type":"array","items":{"$ref":"capability-realisation.schema.json"}},"strategy":{"type":"object","additionalProperties":false,"properties":{"autonomyTarget":{"enum":["maximum","balanced","human-first"]},"realisationPreference":{"type":"array","items":{"enum":["agent","workflow","system","machine","external-service","person","partner"]},"uniqueItems":true}}},"policies":{"type":"array","items":{"$ref":"policy.schema.json"}},"observations":{"type":"array","items":{"$ref":"observation.schema.json"}}},
  "$defs":{"id":{"type":"string","pattern":"^[a-z][a-z0-9_-]*$"}}
