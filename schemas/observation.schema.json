{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://omniform.dev/schemas/observation.schema.json",
  "title":"Observation Definition","type":"object","additionalProperties":false,
  "required":["id","type","capability","condition"],
  "properties":{
    "id":{"type":"string","pattern":"^[a-z][a-z0-9_-]*$"},
    "type":{"type":"string","pattern":"^[a-z][a-z0-9-]*$","examples":["metric","event","semantic","assertion","external-state"]},
    "capability":{"type":"string","pattern":"^[a-z][a-z0-9_-]*$"},
    "condition":{"type":"object","minProperties":1},
    "evidenceRequirements":{"type":"array","items":{"type":"string"}},
    "responses":{"type":"array","items":{"enum":["update-capability-health","create-work","trigger-workflow","notify-agent","notify-person","produce-drift","generate-plan","alert"]}}
  }
}
