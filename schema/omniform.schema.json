{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omniform.org/schema/v1alpha1/omniform.schema.json",
  "title": "Omniform Company",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "omniform.org/v1alpha1" },
    "kind": { "const": "Company" },
    "metadata": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "spec": {
      "type": "object",
      "required": ["providers", "capabilities"],
      "properties": {
        "intent": { "type": "string" },
        "providers": { "type": "object" },
        "capabilities": { "type": "array", "minItems": 1 },
        "resources": { "type": "object" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
