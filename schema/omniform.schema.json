{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omniform.org/schema/v1alpha1/omniform.schema.json",
  "title": "Omniform Company",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "omniform.org/v1alpha1" },
    "kind": { "const": "Company" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": { "$ref": "#/$defs/spec" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$" },
    "jsonSchema": { "type": "object" },
    "primitiveFamily": { "enum": ["agents", "skills", "connectors", "workflows", "schedules", "policies", "observations", "systems", "memory", "identity", "machines"] },
    "metadata": {
      "type": "object", "required": ["id", "name"], "additionalProperties": false,
      "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "type": "string", "minLength": 1 }, "labels": { "type": "object", "additionalProperties": { "type": "string" } } }
    },
    "providerSelection": {
      "type": "object", "required": ["provider"], "additionalProperties": false,
      "properties": { "provider": { "$ref": "#/$defs/id" }, "configuration": { "type": "object" } }
    },
    "providerMap": {
      "type": "object", "minProperties": 1, "additionalProperties": false,
      "properties": {
        "agents": { "$ref": "#/$defs/providerSelection" }, "skills": { "$ref": "#/$defs/providerSelection" }, "connectors": { "$ref": "#/$defs/providerSelection" },
        "workflows": { "$ref": "#/$defs/providerSelection" }, "schedules": { "$ref": "#/$defs/providerSelection" }, "policies": { "$ref": "#/$defs/providerSelection" },
        "observations": { "$ref": "#/$defs/providerSelection" }, "systems": { "$ref": "#/$defs/providerSelection" }, "memory": { "$ref": "#/$defs/providerSelection" },
        "identity": { "$ref": "#/$defs/providerSelection" }, "machines": { "$ref": "#/$defs/providerSelection" }
      }
    },
    "requirement": {
      "type": "object", "required": ["id", "primitiveFamily"], "additionalProperties": false,
      "properties": { "id": { "$ref": "#/$defs/id" }, "primitiveFamily": { "$ref": "#/$defs/primitiveFamily" }, "description": { "type": "string" }, "optional": { "type": "boolean", "default": false } }
    },
    "capability": {
      "type": "object", "required": ["id", "name", "requires"], "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "name": { "type": "string", "minLength": 1 }, "description": { "type": "string" },
        "requires": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/requirement" } },
        "autonomy": { "type": "object", "required": ["mode"], "additionalProperties": false, "properties": { "mode": { "enum": ["observe", "recommend", "plan", "apply_low_risk", "experiment", "delegated"] } } },
        "realisation": { "type": "object", "additionalProperties": false, "properties": { "strategy": { "type": "string" }, "resources": { "type": "array", "items": { "$ref": "#/$defs/id" } } } }
      }
    },
    "resource": {
      "type": "object", "required": ["id", "name"], "additionalProperties": false,
      "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "type": "string", "minLength": 1 }, "offers": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }, "risk": { "enum": ["low", "medium", "high"] }, "constraints": { "type": "object" }, "spec": { "type": "object" } }
    },
    "resources": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "agents": { "$ref": "#/$defs/resourceList" }, "skills": { "$ref": "#/$defs/resourceList" }, "connectors": { "$ref": "#/$defs/resourceList" }, "workflows": { "$ref": "#/$defs/resourceList" },
        "schedules": { "$ref": "#/$defs/resourceList" }, "policies": { "$ref": "#/$defs/resourceList" }, "observations": { "$ref": "#/$defs/resourceList" }, "systems": { "$ref": "#/$defs/resourceList" },
        "memory": { "$ref": "#/$defs/resourceList" }, "identity": { "$ref": "#/$defs/resourceList" }, "machines": { "$ref": "#/$defs/resourceList" }
      }
    },
    "resourceList": { "type": "array", "items": { "$ref": "#/$defs/resource" } },
    "operation": {
      "type": "object", "required": ["id", "capability", "description", "input", "output", "mutation", "permissions", "approval", "interfaces"], "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "capability": { "$ref": "#/$defs/id" }, "description": { "type": "string", "minLength": 1 },
        "input": { "$ref": "#/$defs/jsonSchema" }, "output": { "$ref": "#/$defs/jsonSchema" }, "mutation": { "type": "boolean" },
        "permissions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }, "approval": { "enum": ["none", "required", "policy"] },
        "interfaces": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["lily", "ui", "api", "cli", "agent", "machine", "voice"] } },
        "providerDependencies": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/primitiveFamily" } }
      }
    },
    "outcome": { "type": "object", "required": ["id", "description"], "additionalProperties": false, "properties": { "id": { "$ref": "#/$defs/id" }, "description": { "type": "string" } } },
    "spec": {
      "type": "object", "required": ["providers", "capabilities", "operations"], "additionalProperties": false,
      "properties": {
        "intent": { "type": "string" }, "outcomes": { "type": "array", "items": { "$ref": "#/$defs/outcome" } }, "providers": { "$ref": "#/$defs/providerMap" },
        "capabilities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/capability" } }, "resources": { "$ref": "#/$defs/resources" },
        "operations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/operation" } }
      }
    }
  }
}
